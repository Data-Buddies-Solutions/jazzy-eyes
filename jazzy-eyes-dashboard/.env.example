# Database Connection
# A direct (not pooled) PostgreSQL connection. Production is the jazzy_eyes database on Cloud SQL.
# Over Cloud SQL's public IP, end the URL with ?uselibpqcompat=true&sslmode=require:
# the instance requires encryption and pg verifies plain sslmode=require against public CAs.
DATABASE_URL="postgresql://username:password@localhost:5432/jazzy_eyes"

# Admin Authentication
ADMIN_EMAIL="info@jazzyeyes.com"
ADMIN_PASSWORD="your-password"
